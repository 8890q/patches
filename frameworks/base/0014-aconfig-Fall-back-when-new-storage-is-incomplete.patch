From 307d459e32130e5dd3881e63ea0c0e99565e845d Mon Sep 17 00:00:00 2001
From: ivanmeler <i_ivan@windowslive.com>
Date: Thu, 17 Sep 2026 19:24:20 +0000
Subject: [PATCH] aconfig: Fall back when new storage is incomplete

Change-Id: I49def9d5b55ac40c48fef193e41eb69be2611cb7
---
 .../pm/pkg/component/AconfigFlags.java        | 31 +++++++++++++++++--
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java b/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java
index d1067a79ddcc52d217302df6c647c7a31e795047..0c484bf621806d345314ab2005d46a6ed8f4cfa5 100644
--- a/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java
+++ b/core/java/com/android/internal/pm/pkg/component/AconfigFlags.java
@@ -63,11 +63,17 @@ public class AconfigFlags {
     private static final String LOG_TAG = "AconfigFlags";
     private static final String OVERRIDE_PREFIX = "device_config_overrides/";
     private static final String STAGED_PREFIX = "staged/";
+    private static final String[] PLATFORM_CONTAINERS = {
+            "system", "system_ext", "vendor", "product"
+    };
 
     private final Map<String, Boolean> mFlagValues = new ArrayMap<>();
     private final Map<String, AconfigPackage> mAconfigPackages = new ConcurrentHashMap<>();
+    private final boolean mUseNewStorage;
 
     public AconfigFlags() {
+        mUseNewStorage = useNewStorage();
+
         if (!Flags.manifestFlagging()) {
             if (DEBUG) {
                 Slog.v(LOG_TAG, "Feature disabled, skipped all loading");
@@ -75,7 +81,7 @@ public class AconfigFlags {
             return;
         }
 
-        if (useNewStorage()) {
+        if (mUseNewStorage) {
             Slog.i(LOG_TAG, "Using new flag storage");
         } else {
             Slog.i(LOG_TAG, "Using OLD proto flag storage");
@@ -102,7 +108,26 @@ public class AconfigFlags {
     }
 
     private static boolean useNewStorage() {
-        return newStoragePublicApi() && Flags.useNewAconfigStorage();
+        if (!newStoragePublicApi() || !Flags.useNewAconfigStorage()) {
+            return false;
+        }
+
+        final File storageDirectory =
+                new File(Environment.getMetadataDirectory(), "aconfig");
+        final File mapDirectory = new File(storageDirectory, "maps");
+        final File bootDirectory = new File(storageDirectory, "boot");
+        for (String container : PLATFORM_CONTAINERS) {
+            if (!isReadableStorageFile(new File(mapDirectory, container + ".package.map"))
+                    || !isReadableStorageFile(new File(mapDirectory, container + ".flag.map"))
+                    || !isReadableStorageFile(new File(bootDirectory, container + ".val"))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isReadableStorageFile(File file) {
+        return file.isFile() && file.canRead() && file.length() > 0;
     }
 
     private void loadServerOverrides() {
@@ -224,7 +249,7 @@ public class AconfigFlags {
      */
     @Nullable
     public Boolean getFlagValue(@NonNull String flagPackageAndName) {
-        if (useNewStorage()) {
+        if (mUseNewStorage) {
             return getFlagValueFromNewStorage(flagPackageAndName);
         } else {
             Boolean value = mFlagValues.get(flagPackageAndName);
