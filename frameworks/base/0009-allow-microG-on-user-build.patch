From fa0aeedc0a2b6a260339ab1426c9a92960928f91 Mon Sep 17 00:00:00 2001
From: Yaroslav Zviezda <acroreiser@gmail.com>
Date: Sat, 27 Jun 2026 13:13:19 -0400
Subject: [PATCH] allow microG on user build

Change-Id: Id6e62f6c9cce909ad5e8fadb44ba9e2cd2207c22

Follow signature verification into Android 17 MicrogUtils, retaining package and signer checks.
---
 core/java/com/android/internal/content/MicrogUtils.java | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/core/java/com/android/internal/content/MicrogUtils.java b/core/java/com/android/internal/content/MicrogUtils.java
index 71b32ff6bb24056b4dd3d49fa0e5d392d43dfa72..06f874fa91e03b6cd50a55e3192be65d54694e40 100644
--- a/core/java/com/android/internal/content/MicrogUtils.java
+++ b/core/java/com/android/internal/content/MicrogUtils.java
@@ -42,12 +42,11 @@ public final class MicrogUtils {
     }
 
     /**
-     * Whether the package is a microG package signed with the real microG key. Always false on
-     * non-debuggable builds.
+     * Whether the package is a microG package signed with the real microG key.
      */
     public static boolean isMicrogSigned(@NonNull AndroidPackage pkg) {
         SigningDetails signingDetails = pkg.getSigningDetails();
-        return isDebuggable() && isMicrogPackageName(pkg.getPackageName())
+        return isMicrogPackageName(pkg.getPackageName())
                 && signingDetails != null
                 && Signature.areExactMatch(signingDetails, new Signature[]{REAL_SIGNATURE});
     }
